NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://webhook_relay:webhook_relay@localhost:5432/webhook_relay
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

DELIVERY_MAX_ATTEMPTS=8
DELIVERY_TIMEOUT_MS=10000
DELIVERY_CONCURRENCY=10
# PROCESSING rows refresh this durable lease while a worker owns them.
DELIVERY_PROCESSING_HEARTBEAT_MS=5000
# If the lease is older than this, another worker may recover the delivery.
DELIVERY_PROCESSING_STALE_MS=60000
# Required in production to enable outbound webhook delivery. Exact hostnames only.
WEBHOOK_ALLOWED_HOSTS=
SUBSCRIPTION_AUTO_DISABLE_THRESHOLD=5

# Required for production API/worker and secret backfill: 32 random bytes in hex.
# Store outside the database/repository; API and workers must use the same key.
# SIGNING_SECRET_KEY=
