# Copy to .env.production (gitignored), chmod 600, fill every blank before starting.
# Use separate 32-byte hex values: openssl rand -hex 32 (URL-safe for database/Redis).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SIGNING_SECRET_KEY=
# Exact browser origins, comma-separated, without trailing slash.
CORS_ORIGINS=https://relay.example.com
PUBLIC_API_URL=https://api.relay.example.com
WEBHOOK_ALLOWED_HOSTS=receiver.example.com
# 0 for direct localhost access; set only for a known, fixed reverse-proxy topology.
TRUST_PROXY_HOPS=0
DELIVERY_MAX_REPLAYS=5
API_PORT=3000
WEB_PORT=5173
# First-time provisioning only; save the token securely and remove it after bootstrap.
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_API_KEY=
